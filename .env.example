# ==========================================================================
# Exemplo de configuração — copie para .env e preencha com seus dados.
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
# NUNCA versione o arquivo .env com credenciais reais.
# ==========================================================================

# --- Amazon Bedrock / AWS ---
AWS_REGION=us-east-2
SSO_REGION=us-east-1
SSO_START_URL=https://d-90663e488b.awsapps.com/start
SSO_ACCOUNT_ID=coloque_o_account_id_aqui
SSO_ROLE_NAME=BedrockFullAccess
BEDROCK_MODEL_ID=us.meta.llama4-scout-17b-instruct-v1:0
BEDROCK_TEMPERATURE=0.0
BEDROCK_MAX_TOKENS=512

# (Opcional) Credenciais estáticas em vez de login SSO interativo:
# AWS_ACCESS_KEY_ID=coloque_aqui
# AWS_SECRET_ACCESS_KEY=coloque_aqui
# AWS_SESSION_TOKEN=coloque_aqui

# --- Banco de dados (PostgreSQL) ---
DB_ENGINE=postgresql
DB_HOST=coloque_o_host_aqui
DB_PORT=5432
DB_NAME=coloque_o_nome_do_banco_aqui
DB_USER=coloque_o_usuario_aqui
DB_PASSWORD=coloque_a_senha_aqui
DB_SCHEMA=public

# (Alternativa) URL completa do SQLAlchemy (tem prioridade sobre os campos acima):
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/banco

# --- Escopo / VIEW ---
VIEW_NAME=vw_escopo_ia

# --- Overrides opcionais de relacionamento (use só se a detecção automática falhar) ---
# FK_MUNICIPIO=co_municipio
# PK_MUNICIPIO=codigo_municipio_dv
# FK_MUNICIPIO_UF=cd_uf
# PK_UF=cd_uf
# FK_UF_REGIAO=cd_regiao
# PK_REGIAO=cd_regiao
# COL_NOME_MUNICIPIO=nome_municipio
# COL_NOME_UF=nome_uf
# COL_NOME_REGIAO=nome_regiao
